{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panda Companion",
  "version": "0.1.0",
  "identifier": "com.pandacompany.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Panda Companion",
      "width": 360,
      "height": 600,
      "minWidth": 80,
      "minHeight": 80,
      "resizable": true,
      "decorations": false,
      "alwaysOnTop": true,
      "transparent": true,
      "shadow": true
    }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: data: blob:; connect-src ipc: http://ipc.localhost https://api.openai.com https://cdn.jsdelivr.net; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval';" }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "A floating AI panda companion",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    },
    "macOS": { "minimumSystemVersion": "14.0", "infoPlist": "Info.plist" }
  }
}
